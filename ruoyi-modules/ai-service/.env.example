# Copy to .env and set the API key locally. Process environment overrides .env.
DASHSCOPE_API_KEY=
# Deferred by user: fill WorkspaceId OR both business-space endpoint URLs before integration.
BAILIAN_WORKSPACE_ID=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen3.8-flash
BAILIAN_MULTIMODAL_MODEL=qwen3.8-omni-flash
BAILIAN_EMBEDDING_MODEL=qwen3.7-text-embedding
BAILIAN_EMBEDDING_DIMENSIONS=1024
BAILIAN_RERANK_MODEL=qwen3.7-text-rerank
BAILIAN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
BAILIAN_TIMEOUT_SECONDS=60

# Independent credentials; generate locally. Never share with App clients.
RAG_INTERNAL_TOKEN=
CAMUNDA_WORKER_TOKEN=
# MySQL deployment requires an existing dedicated logical DB and explicit init-db.
RAG_DATABASE_URL=mysql://kcat_rag:CHANGE_LOCALLY@127.0.0.1:3306/kcat_rag
CONTENT_SERVICE_URL=http://127.0.0.1:10001
CAMUNDA_REST_URL=http://127.0.0.1:8088/engine-rest
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
RAG_DATA_DIR=data
RAG_PIPELINE_VERSION=evidence-v1
RAG_MEDIA_ALLOWED_HOSTS=localhost,127.0.0.1,minio
RAG_SEGMENT_SECONDS=20
# Provisional score threshold: calibrate against human-labelled queries.
RAG_MIN_RERANK_SCORE=0.2
